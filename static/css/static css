* {
	box-sizing: border-box;
}

body {
	margin: 0;
	font-family: Arial, Helvetica, sans-serif;
	background: #f5f1ea;
	color: #202020;
}

.hero {
	min-height: 100vh;
	display: grid;
	place-items: center;
	background: linear-gradient(135deg, #eee3d3, #ffffff);
}

.container {
	width: min(1000px, 92%);
	margin: 32px auto;
}

.card {
	background: white;
	border-radius: 20px;
	padding: 28px;
	box-shadow: 0 12px 35px rgba(0, 0, 0, 0.09);
}

.hero .card {
	max-width: 760px;
}

h1 {
	font-size: 38px;
	margin: 0 0 8px;
}

h2 {
	margin-top: 0;
}

.subtitle {
	color: #666;
	margin-bottom: 28px;
}

label {
	display: block;
	font-weight: 700;
	margin: 16px 0;
}

input,
textarea,
select {
	display: block;
	width: 100%;
	margin-top: 8px;
	padding: 13px;
	border: 1px solid #ccc;
	border-radius: 10px;
	font: inherit;
}

textarea {
	min-height: 130px;
	resize: vertical;
}

.grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 8px 20px;
}

button,
.button {
	display: inline-block;
	border: 0;
	border-radius: 10px;
	padding: 13px 18px;
	background: #202020;
	color: white;
	text-decoration: none;
	cursor: pointer;
	font-weight: 700;
}

button:hover,
.button:hover {
	opacity: 0.85;
}

.secondary {
	background: #777;
}

.error {
	padding: 12px;
	border-radius: 10px;
	background: #ffe4e4;
	color: #8b0000;
	margin-bottom: 20px;
}

.top {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 20px;
}

.panel {
	margin-bottom: 25px;
}

.panel img {
	display: block;
	width: 100%;
	max-height: 700px;
	object-fit: contain;
	border-radius: 12px;
	background: #eee;
}

.scene {
	color: #555;
}

.actions {
	text-align: center;
	margin: 35px;
}

.center {
	text-align: center;
}

@media (max-width: 650px) {
	.grid {
		grid-template-columns: 1fr;
	}

	h1 {
		font-size: 30px;
	}

	.top {
		gap: 12px;
		align-items: flex-start;
		flex-direction: column;
	}
}
